# PostgreSQL connection string
# Get a free one from https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname

# Clerk backend secret key
# From https://dashboard.clerk.com → Your App → API Keys
CLERK_SECRET_KEY=sk_live_...

# OpenAI API key (for local development)
# Get one from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Comma-separated list of admin email addresses
ADMIN_EMAILS=you@example.com

# Any random string (used for session security)
SESSION_SECRET=change-me-to-something-random

# Optional
NODE_ENV=development
LOG_LEVEL=info
